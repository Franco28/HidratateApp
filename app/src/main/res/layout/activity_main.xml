<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/header_image_size"
                    android:layout_height="@dimen/header_image_size"
                    android:contentDescription="@string/drop_content_description"
                    android:src="@drawable/ic_drop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_14"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2xs"
                        android:includeFontPadding="false"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- FECHA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/date_pill_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_date_pill"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <ImageView
                    android:layout_width="@dimen/icon_size_sm"
                    android:layout_height="@dimen/icon_size_sm"
                    android:contentDescription="@string/calendar_content_description"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PROGRESO CIRCULAR -->
            <FrameLayout
                android:layout_width="@dimen/progress_container_size"
                android:layout_height="@dimen/progress_container_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_lg">

                <com.lms.hidratateapp.CircularProgressView
                    android:id="@+id/circularProgress"
                    android:layout_width="@dimen/progress_view_size"
                    android:layout_height="@dimen/progress_view_size"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/drop_icon_size"
                        android:layout_height="@dimen/drop_icon_size"
                        android:contentDescription="@string/drop_content_description"
                        android:src="@drawable/ic_drop" />

                    <TextView
                        android:id="@+id/tvCurrentWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_alt_sm"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_metric"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2xs"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_alt_sm"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_subheading"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- AGREGAR AGUA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:text="@string/add_water"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn250"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/quick_button_height"
                    android:layout_marginEnd="@dimen/spacing_10"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_primary"
                    android:drawableTop="@drawable/ic_glass_white"
                    android:drawablePadding="@dimen/spacing_alt_sm"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingTop="20dp"
                    android:stateListAnimator="@null"
                    android:text="@string/add_250"
                    android:textAllCaps="false"
                    android:textColor="@color/surface"
                    android:textSize="@dimen/text_caption"
                    tools:ignore="ButtonStyle" />

                <Button
                    android:id="@+id/btn500"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/quick_button_height"
                    android:layout_marginEnd="@dimen/spacing_10"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_secondary"
                    android:drawableTop="@drawable/ic_glass"
                    android:drawablePadding="@dimen/spacing_alt_sm"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingTop="20dp"
                    android:stateListAnimator="@null"
                    android:text="@string/add_500"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    tools:ignore="ButtonStyle" />

                <Button
                    android:id="@+id/btn750"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/quick_button_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_secondary"
                    android:drawableTop="@drawable/ic_glass"
                    android:drawablePadding="@dimen/spacing_alt_sm"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingTop="20dp"
                    android:stateListAnimator="@null"
                    android:text="@string/add_750"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    tools:ignore="ButtonStyle" />
            </LinearLayout>

            <!-- CANTIDAD PERSONALIZADA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/button_height"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/bg_input_icon_box"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/icon_size_sm"
                        android:layout_height="@dimen/icon_size_md"
                        android:contentDescription="@string/glass_content_description"
                        android:src="@drawable/ic_glass" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etCustomAmount"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_10"
                    android:layout_weight="1"
                    android:autofillHints="none"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:hint="@string/custom_amount_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:maxLines="1"
                    android:paddingStart="@dimen/spacing_14"
                    android:paddingEnd="@dimen/spacing_14"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="100dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_10"
                    android:background="@drawable/bg_quick_primary"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/add"
                    android:textAllCaps="false"
                    android:textColor="@color/surface"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- HISTORIAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/history_today"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/historyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_alt_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_alt_sm">

                <LinearLayout
                    android:id="@+id/historyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- NAVBAR FIJO ABAJO DEL TODO -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_height"
        android:background="@drawable/bg_nav_bar"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_22"
        android:paddingEnd="@dimen/spacing_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/todayNavItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawablePadding="@dimen/spacing_alt_sm"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="20dp"
            android:text="@string/today"
            android:textColor="@color/blue_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            app:drawableTopCompat="@drawable/ic_home" />

        <TextView
            android:id="@+id/settingsNavItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawablePadding="@dimen/spacing_alt_sm"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="20dp"
            android:text="@string/settings"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            app:drawableTopCompat="@drawable/ic_settings" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
